<!-- Model Dropdown -->
<div class="filter-group">
    <form id="filter-form" action="/items" method="POST">
         <input type="hidden" name="selectedModel" id="selectedModelInput">
        <label for="filter-model" class="filter-label">Filter by Model:</label>
        <select id="filter-model" class="filter-input">
            <option value="" disabled selected>All Models</option>
            <% models.forEach(model => {
                %>
                <option value="<%= model.toLowerCase() %>">
                    <%= model %>
            </option>
            <% }) %>
        </select>
    
    <!-- Trim Dropdown -->
    <label for="filter-trim" class="filter-label">Filter by Trim:</label>
    <div class="filter-group">
            <select id="filter-trim" class="filter-input">
                <option value="" disabled selected>All Trims</option>
            </select>
        </div>
       <input type="submit" value="Apply Filters" class="filter-submit-btn">
    </form>
    <!-- Year Dropdown -->
    <!-- <div class="filter-group">
            <select id="filter-year" class="filter-input">
                <option value="">All Years</option>
                <% const years=[...new Set(trims.map(i=> i.year).filter(Boolean))].sort((a, b) => b - a);
                    years.forEach(year => {
                    %>
                    <option value="<%= year %>">
                        <%= year %>
                    </option>
                    <% }) %>
            </select>
        </div> -->
    <script>

        const filterModel = document.getElementById('filter-model');
        const filterTrim = document.getElementById('filter-trim');

        filterModel.addEventListener('change', function() {
            const selectedModel = this.value;
            const filteredTrims = trims.filter(trim => trim.model.toLowerCase() === selectedModel);
            filterTrim.innerHTML = '<option value="" disabled selected>All Trims</option>';
            filteredTrims.forEach(trim => {
                const option = document.createElement('option');
                option.value = trim.trim.toLowerCase();
                option.textContent = trim.trim;
                filterTrim.appendChild(option);
            });
        });
    </script>
</div>