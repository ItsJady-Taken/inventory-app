<!-- Model Dropdown -->
<div class="filter-group">
    <form id="filter-form" action="/items/filter" method="GET" class="filter-form-row">
        <input type="hidden" name="category_id" id="category_id" value="<%= categoryId %>">
        <input type="hidden" name="brand" id="brand" value="<%= brand %>">

        <!-- Model Dropdown -->
         <div>
            <label for="filter-model" class="filter-label">Filter by Model:</label>
            <select id="filter-model" class="filter-input" name="model">
            <option value="" disabled selected>All Models</option>
            <% models.forEach(model => {
                %>
                <option value="<%= model.toLowerCase() %>">
                    <%= model %>
            </option>
            <% }) %>
        </select>
         </div>
       
     <!-- Year Dropdown -->
    <div class="filter-group">
            <select id="filter-year" class="filter-input">
                <option value="">All Years</option>
                <% const years=[...new Set(trims.map(i=> i.year).filter(Boolean))].sort((a, b) => b - a);
                    years.forEach(year => {
                    %>
                    <option value="<%= year %>">
                        <%= year %>
                    </option>
                    <% }) %>
            </select>
        </div>
    <!-- Trim Dropdown -->
        <!-- <label for="filter-trim" class="filter-label">Filter by Trim:</label>
        <div class="filter-group">
            <select id="filter-trim" class="filter-input">
                <option value="" disabled selected>All Trims</option>
            </select>
        </div> -->
     <!-- Submit Button -->
        <div class="filter-item filter-action">
            <label class="filter-label filter-label-spacer" aria-hidden="true">Apply</label>
            <button type="submit" class="filter-submit-btn">Apply Filters</button>
        </div>

    </form>
   
