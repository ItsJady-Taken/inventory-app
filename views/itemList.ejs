<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/categoryId.css">
    <link rel="stylesheet" href="/addCategory.css">
    <link rel="stylesheet" href="/nav.css">
    <link rel="stylesheet" href="/style.css">
    <link rel="stylesheet" href="/addItem.css">
    <title>Document</title>
</head>
<body>
    <%- include('partials/nav') %>
        <%- include('partials/searchBar') %>
    <%- include('partials/addCategory', { categories: categories }) %>
            <!-- views/category.ejs -->
            <div class="category-page-container">
            
                <!-- Category Header Section -->
                <div class="category-header">
                    <h3 class="category-title">
                        <%= category.name %>
                    </h3>

                    <%- include('partials/addItem', { category: category }) %>
             
                    <!-- Form to Delete the Entire Category -->
                    <form action="/categories/<%= category.id %>?_method=DELETE" method="POST" class="delete-form"
                        onsubmit="return confirm('Are you sure you want to delete this entire category and all its items?');">
                        <button type="submit" class="delete-category-btn" title="Delete Category">&times;</button>
                    </form>
                </div>
            
                <!-- Items Grid Container -->
                <div class="items-grid">
                    <% if (locals.items && items.length> 0) { %>
                        <% items.forEach(item=> { %>
                            <div class="item-card">
                                <!-- Item Delete Button ("X") -->
                                <form action="/items/<%= item.id %>?_method=DELETE" method="POST" class="item-delete-form"
                                    onsubmit="return confirm('Delete this vehicle?');">
                                    <button type="submit" class="delete-item-btn" title="Delete Item">&times;</button>
                                </form>
            
                                <!-- Item Image -->
                                <% if (item.image_url) { %>
                                    <img src="<%= item.image_url %>" alt="<%= item.name %>" class="item-image">
                                    <% } else { %>
                                        <div class="item-image-placeholder">No Image</div>
                                        <% } %>
            
                                            <!-- Item Info -->
                                            <div class="item-info">
                                                <h4 class="item-name">
                                                    <%= item.name %>
                                                </h4>
                                                <p class="item-desc">
                                                    <%= item.description %>
                                                </p>
                                            </div>
                            </div>
                            <% }) %>
                                <% } else { %>
                                        <p class="no-items-msg">No vehicles found in this category yet.</p>
                                    <% } %>
                </div>
            </div>
</body>
</html>